{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FMLibreEditor",
  "mainBinaryName": "FMLibreEditor",
  "version": "0.5.2",
  "identifier": "io.github.tozmoz.fmlibreeditor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FMLibreEditor",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "FMLibreEditor contributors",
    "copyright": "Copyright (C) 2026 FMLibreEditor contributors. GPL-3.0-or-later.",
    "category": "Utility",
    "shortDescription": "Real-time editor for Football Manager 27",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish", "Spanish", "German", "French", "Italian", "Japanese", "Korean", "Russian"],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGQ0MyMEY1QkQzQzZCMTgKUldRWWF6eTk5U0RNVHhYVEZxZU1JanA5RnMvVytFREZya3UxMVRzUHJhZDdUSFVKVG14VWhpYzcK",
      "endpoints": ["https://github.com/tozmoz/FMLibreEditor/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
